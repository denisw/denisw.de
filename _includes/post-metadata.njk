
<!-- Description -->
<link rel="description" content="{{ description }}">

<!-- Canonical URL -->
<link rel="canonical" content="{{ page.url | absolute }}">

<!-- Schema.org -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "@id": {{ page.url | absolute | dump | safe }},
  "headline": {{ title | dump | safe }},
  "description": {{ description | dump | safe }},
  "datePublished": {{ page.date | dateToRfc3339 | dump | safe }},
  "dateModified": {{ page.date | dateToRfc3339 | dump | safe }},
  "image": [{{ '/images/cover.jpg' | absolute | dump | safe }}],
  "author": [
    {
      "@type": "Person",
      "name": "Denis Washington",
      "url": {{ site.url | dump | safe }}
    }
  ]
}
</script>

<!-- OpenGraph (Facebook) -->
<meta property="og:type" content="article">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:url" content="{{ page.url | absolute }}">
<meta property="og:image" content="{{ '/images/cover.jpg' | absolute }}">
<meta property="og:article:published_time" content="{{ page.date | isoDate }}">
<meta property="og:article:author:first_name" content="Denis">
<meta property="og:article:author:last_name" content="Washington">


<!-- Twitter Card -->
<meta name="twitter:card" content="summary">
<meta name="twitter:title" content="{{ title }}">
<meta name="twitter:creator" content="@{{ me.twitter.username }}">
<meta name="twitter:site" content="@{{ me.twitter.username }}">
<meta name="twitter:url" content="{{ page.url | absolute }}">
<meta name="twitter:image" content="{{ '/images/cover.jpg' | absolute }}">
