<!-- Canonical URL -->
<link rel="canonical" content="{{ page.url | prepend: site.url }}">

<!-- Schema.org -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "@id": {{ page.url | prepend: site.url | json }},
  "headline": {{ title | json }},
  "description": {{ description | json }},
  "datePublished": {{ page.date | date: '%Y-%m-%d' | json }},
  "dateModified": {{ page.date | date: '%Y-%m-%d' | json }},
  "image": [{{ '/images/cover.jpg' | prepend: site.url  | json }}],
  "author": [
    {
      "@type": "Person",
      "name": "Denis Washington",
      "url": {{ site.url | json }}
    }
  ]
}
</script>

<!-- OpenGraph (Facebook) -->
<meta property="og:type" content="article">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:url" content="{{ page.url | prepend: site.url }}">
<meta property="og:image" content="{{ '/images/cover.jpg' | prepend: site.url }}">
<meta property="og:article:published_time" content="{{ page.date | date: '%Y-%m-%d' }}">
<meta property="og:article:author:first_name" content="Denis">
<meta property="og:article:author:last_name" content="Washington">

<!-- Twitter Card -->
<meta name="twitter:card" content="summary">
<meta name="twitter:title" content="{{ title }}">
<meta name="twitter:creator" content="@{{ me.twitter.username }}">
<meta name="twitter:site" content="@{{ me.twitter.username }}">
<meta name="twitter:url" content="{{ page.url | prepend: site.url }}">
<meta name="twitter:image" content="{{ '/images/cover.jpg' | prepend: site.url }}">
